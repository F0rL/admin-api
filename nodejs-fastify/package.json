{
  "name": "@admin-api/fastify-skeleton",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "dev:init": "tsx scripts/init-dev.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "docker:up": "docker compose -f ../docker-compose.yml up -d",
    "docker:down": "docker compose -f ../docker-compose.yml down",
    "docker:logs": "docker compose -f ../docker-compose.yml logs -f",
    "postinstall": "node -e \"try{require('fs').existsSync('.env')&&require('child_process').execSync('npx prisma generate',{stdio:'inherit',env:{...process.env,DATABASE_URL:process.env.DATABASE_URL||'mysql://skip@localhost:3306/skip'}})}catch(e){console.log('  [postinstall] DATABASE_URL 未配置，跳过 Prisma Client 生成（执行 pnpm dev:init 时会生成）')}\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@prisma/client": "^6.5.0",
    "axios": "^1.7.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.45.0",
    "dotenv": "^16.4.0",
    "fastify": "^5.3.0",
    "ioredis": "^5.6.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "uuidv7": "^1.2.1",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "nodemon": "^3.1.0",
    "prisma": "^6.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
