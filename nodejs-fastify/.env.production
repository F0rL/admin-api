# ==========================================
# 生产环境配置（NODE_ENV=prod）
# 覆盖 .env 中的公共配置项
# 自行修改为实际部署环境的值
# ==========================================

# 应用
NODE_ENV=prod
PORT=4000
HOST=0.0.0.0

# 数据库 - MySQL 8（生产数据库地址）
DATABASE_URL=mysql://admin:your-password@prod-db-host:3306/admin_api

# Redis - Session 存储 + BullMQ（生产 Redis 地址）
REDIS_URL=redis://:your-password@prod-redis-host:6379/0

# Session 密钥（使用 openssl rand -hex 32 生成）
SESSION_SECRET=your-production-session-secret-at-least-32-chars

# 生产环境建议启用队列
QUEUE_ENABLED=true
