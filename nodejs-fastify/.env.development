# ==========================================
# 开发环境配置（NODE_ENV=dev）
# 覆盖 .env 中的公共配置项
# MySQL / Redis 通过 WSL2 Docker Compose 部署
# ==========================================

# 应用
NODE_ENV=dev

# 数据库 - MySQL 8（WSL2 Docker，端口映射 3306）
# docker-compose 配置：root 密码 root123，初始化数据库 dev_db
DATABASE_URL=mysql://root:root123@localhost:3306/dev_db

# Redis 7（WSL2 Docker，端口映射 6379，开启 AOF 持久化，密码 redis123）
REDIS_URL=redis://:redis123@localhost:6379/0

# Session 密钥（至少 32 位）
SESSION_SECRET=dev-session-secret-change-in-production-1234

# 开发环境暂不启用队列
QUEUE_ENABLED=false
