# ==========================================
# 环境变量配置示例
#
# 配置采用三层结构：
#   .env               - 公共配置（SESSION_TTL / QUEUE_ENABLED 等，提交版本管理）
#   .env.development   - 开发环境（NODE_ENV=dev 时加载，覆盖 .env）
#   .env.production    - 生产环境（NODE_ENV=prod 时加载，覆盖 .env）
#
# 使用方式：
#   - 开发：在 .env.development 中配置 Docker 服务地址
#   - 生产：在 .env.production 中配置实际部署地址
#   - 测试：在 tests/setup.ts 中设置默认值
# ==========================================

# ---- 应用 ----
NODE_ENV=dev
PORT=3000
HOST=0.0.0.0

# ---- 数据库（MySQL 8）----
# 格式：mysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql://root:password@localhost:3306/admin_api

# ---- Redis（Session 存储 + BullMQ 队列）----
# 格式：redis://[用户名:密码@]主机:端口/库编号
REDIS_URL=redis://localhost:6379/0

# ---- Session ----
# 密钥：建议使用 openssl rand -hex 32 生成，至少 32 位
SESSION_SECRET=your-session-secret-at-least-32-chars-long
# 有效期（秒）：86400 = 1 天
SESSION_TTL=86400

# ---- BullMQ 队列 ----
QUEUE_ENABLED=false
