# ==========================================
# 环境变量配置示例
#
# 配置采用三层结构：
#   .env               - 公共配置（SESSION_TTL / QUEUE_ENABLED 等，提交版本管理）
#   .env.development   - 开发环境（NODE_ENV=dev 时加载，覆盖 .env）
#   .env.production    - 生产环境（NODE_ENV=prod 时加载，覆盖 .env）
#
# 使用方式：
#   - 开发：在 .env.development 中配置 Docker 服务地址
#   - 生产：在 .env.production 中配置实际部署地址
#   - 测试：在 tests/setup.ts 中设置默认值
# ==========================================

# ---- 应用 ----
NODE_ENV=dev
PORT=4000
HOST=0.0.0.0

# ---- 数据库（MySQL 8）----
# 格式：mysql://用户名:密码@主机:端口/数据库名
# 开发环境默认值，与 docker-compose.yml 一致
DATABASE_URL=mysql://root:root123@localhost:3306/dev_db

# ---- Redis（Session 存储 + BullMQ 队列）----
# 格式：redis://[用户名:密码@]主机:端口/库编号
# 开发环境默认值，与 docker-compose.yml 一致
REDIS_URL=redis://:redis123@localhost:6379/0

# ---- Session ----
# 有效期（秒）：86400 = 1 天
SESSION_TTL=86400

# ---- BullMQ 队列 ----
QUEUE_ENABLED=false
